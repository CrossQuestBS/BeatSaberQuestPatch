<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="CrossAccord">
        <HintPath>..\..\CrossAccord\CrossAccord\bin\Release\netstandard2.1\CrossAccord.dll</HintPath>
      </Reference>
      <Reference Include="CrossAccord.Common">
        <HintPath>..\..\CrossAccord\CrossAccord.Common\bin\Release\netstandard2.1\CrossAccord.Common.dll</HintPath>
      </Reference>
      <Analyzer Include="..\..\CrossAccord\CrossAccord.Generator\CrossAccord.Generator\bin\Release\netstandard2.0\CrossAccord.Generator.dll" />
      <Reference Include="IPA.Loader">
        <HintPath>Dependencies\IPA.Loader.dll</HintPath>
      </Reference>
      <Reference Include="Main" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll" Publicize="true" />
      <Reference Include="BeatSaber.GameSettings" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\BeatSaber.GameSettings.dll"/>
      <Reference Include="BGLib.FileStorage" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.FileStorage.dll"/>
      <Reference Include="GameInit" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\GameInit.dll" Publicize="true"/>
      <Reference Include="BeatSaber.Settings" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\BeatSaber.Settings.dll"/>
      <Reference Include="Rendering" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Rendering.dll" Publicize="true"/>
      <Reference Include="GameplayCore" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\GameplayCore.dll" Publicize="true"/>
        <Reference Include="DataModels" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\DataModels.dll" Publicize="true"/>
        <Reference Include="Helpers" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Helpers.dll" Publicize="true"/>
      <Reference Include="Oculus.Platform" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Oculus.Platform.dll"/>
      <Reference Include="Oculus.VR" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\Oculus.VR.dll"/>
      <Reference Include="UnityEngine.UI" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll" />
      <Reference Include="UnityEngine.CoreModule" HintPath="$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="manifest.json" />
    </ItemGroup>


</Project>
